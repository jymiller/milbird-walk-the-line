# Generated from .hackathon/env.requirements.json — NO VALUES, ever.
# Copy to .env and fill only what the day's build actually needs.

# ---- agentx ----
# required: Self-hosted governance engine API root
#   source: local agentx-trace-eval server
AGENTX_API_BASE_URL=http://localhost:4700/api/v1
# required: Project key for trace ingest and eval runs
#   source: printed by the engine on boot; regenerated per install
AGENTX_API_KEY=

# ---- edgeone ----
# optional: Non-interactive CLI auth; only needed if avoiding browser login
#   source: EdgeOne console
EDGEONE_PAGES_API_TOKEN=

# ---- memories ----
# optional: sk-mavi-* key covering Visual Intelligence, Search and Agents
#   source: console.memories.ai
MEMORIES_API_KEY=

# ---- velodb ----
# optional: MySQL-protocol endpoint
VELODB_HOST=
# optional: Query port
VELODB_PORT=9030
# optional: Warehouse user
VELODB_USER=
# optional: Warehouse password
VELODB_PASSWORD=
# optional: Target database
VELODB_DATABASE=

# ---- aws ----
# optional: Only if the build itself calls AWS; prize credits do not require it
AWS_ACCESS_KEY_ID=
# optional: Pairs with AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=
# optional: Region for any AWS call
AWS_REGION=us-west-2

# ---- anthropic ----
# optional: Unlocks AgentX LLM-judge scoring; trace ingest does not need it
ANTHROPIC_API_KEY=

# ---- openai ----
# optional: Alternative judge provider for AgentX evaluations
OPENAI_API_KEY=
